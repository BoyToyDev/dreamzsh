#!/usr/bin/env zsh

setopt NO_UNSET 2>/dev/null || true

if [[ -z "${DREAMZSH_DIR:-}" ]]; then
  SCRIPT_DIR="${0:A:h}"
  export DREAMZSH_DIR="${SCRIPT_DIR:h}"
fi

source "${DREAMZSH_DIR}/core/utils.zsh" || exit 1
source "${DREAMZSH_DIR}/core/config.zsh" || exit 1
source "${DREAMZSH_DIR}/core/help.zsh" || exit 1
source "${DREAMZSH_DIR}/core/plugins.zsh" || exit 1
source "${DREAMZSH_DIR}/core/theme.zsh" || exit 1
source "${DREAMZSH_DIR}/core/profiles.zsh" || exit 1
source "${DREAMZSH_DIR}/core/status.zsh" || exit 1
source "${DREAMZSH_DIR}/core/backup.zsh" || exit 1
source "${DREAMZSH_DIR}/core/doctor.zsh" || exit 1
source "${DREAMZSH_DIR}/core/update.zsh" || exit 1
source "${DREAMZSH_DIR}/core/uninstall.zsh" || exit 1
source "${DREAMZSH_DIR}/core/stats.zsh" || exit 1

dz::config::load || exit 1

command_name="${1:-help}"
shift || true

main_commands=(plugin theme profile backup status config doctor reload update uninstall stats help version)
plugin_subcommands=(list browse repo create install update remove enable disable info help)
theme_subcommands=(list create set preview current help)
profile_subcommands=(list info apply current export import help)
backup_subcommands=(create list restore clean help)

case "$command_name" in
  help|-h|--help)
    dz::help::command "${1:-}" "${2:-}" || exit 1
    ;;
  version|-v|--version)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command version
      exit 0
    fi
    (( $# == 0 )) || { dz::usage_error "Unknown version option: $1" "Usage: dreamzsh version"; exit 1; }
    print -r -- "DreamZSH $DREAMZSH_VERSION"
    ;;
  status)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command status
      exit 0
    fi
    (( $# == 0 )) || { dz::usage_error "Unknown status option: $1" "Usage: dreamzsh status"; exit 1; }
    dz::status::run
    ;;
  config)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command config
      exit 0
    fi
    (( $# == 0 )) || { dz::usage_error "Unknown config option: $1" "Usage: dreamzsh config"; exit 1; }
    dz::config::print
    ;;
  doctor)
    case "${1:-}" in
      -h|--help) dz::help::command doctor; exit 0 ;;
      --fix) shift; (( $# == 0 )) || { dz::usage_error "Unknown doctor option: $1" "Usage: dreamzsh doctor [--fix]"; exit 1; }; dz::doctor::fix || exit 1 ;;
      "") dz::doctor::run || exit 1 ;;
      *) dz::usage_error "Unknown doctor option: $1" "Usage: dreamzsh doctor [--fix]"; exit 1 ;;
    esac
    ;;
  reload)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command reload
      exit 0
    fi
    if [[ "${1:-}" == "--exec" ]]; then
      shift
      exec zsh
    fi
    dz::warn "The standalone CLI cannot replace its parent shell."
    dz::info "Run 'dreamzsh reload' from a shell initialized by DreamZSH."
    dz::info "Fallback: exec zsh"
    ;;
  update)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command update
      exit 0
    fi
    (( $# == 0 )) || { dz::usage_error "Unknown update option: $1" "Usage: dreamzsh update"; exit 1; }
    dz::update::run || exit 1
    ;;
  uninstall)
    uninstall_purge=0
    uninstall_yes=0
    while (( $# > 0 )); do
      case "$1" in
        -h|--help) dz::help::command uninstall; exit 0 ;;
        --purge) uninstall_purge=1 ;;
        --yes) uninstall_yes=1 ;;
        *) dz::usage_error "Unknown uninstall option: $1" "Usage: dreamzsh uninstall [--purge] [--yes]"; exit 1 ;;
      esac
      shift
    done
    if (( uninstall_purge )); then
      if (( uninstall_yes )); then
        dz::uninstall::purge --yes
      else
        dz::uninstall::purge
      fi
    else
      if (( uninstall_yes )); then
        dz::uninstall::run --yes
      else
        dz::uninstall::run
      fi
    fi
    (( $? == 0 )) || exit 1
    ;;
  stats)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command stats
      exit 0
    fi
    (( $# == 0 )) || { dz::usage_error "Unknown stats option: $1" "Usage: dreamzsh stats"; exit 1; }
    dz::stats::run
    ;;
  plugin)
    subcommand="${1:-help}"
    shift || true

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command plugin "$subcommand" || exit 1
      exit 0
    fi

    case "$subcommand" in
      help|-h|--help)
        dz::help::plugin
        ;;
      list)
        dz::plugin::list
        ;;
      browse)
        dz::registry::browse "$@" || exit 1
        ;;
      repo)
        repo_command="${1:-list}"
        shift || true
        if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
          dz::help::command plugin repo
          exit 0
        fi
        case "$repo_command" in
          list|help|-h|--help)
            dz::registry::repo_list
            ;;
          add)
            dz::registry::repo_add "$@" || exit 1
            ;;
          remove)
            [[ -n "${1:-}" ]] || {
              dz::usage_error "Missing plugin repository name." "Usage: dreamzsh plugin repo remove <name>"
              exit 1
            }
            dz::registry::repo_remove "$1" || exit 1
            ;;
          update)
            dz::registry::repo_update "${1:---all}" || exit 1
            ;;
          *)
            dz::unknown_command "$repo_command" list add remove update
            exit 1
            ;;
        esac
        ;;
      create)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin create <name>"
          exit 1
        }
        dz::plugin::create "$1" || exit 1
        ;;
      install)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing plugin source." "Usage: dreamzsh plugin install <owner/repo|https-url> [options]"
          exit 1
        }
        dz::plugin::install "$@" || exit 1
        ;;
      update)
        (( $# > 0 )) || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin update <name> [name...] | --all"
          exit 1
        }
        dz::plugin::update_external "$@" || exit 1
        ;;
      remove)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin remove <name> [--yes]"
          exit 1
        }
        dz::plugin::remove_external "$@" || exit 1
        ;;
      enable)
        (( $# > 0 )) || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin enable <name> [name...]"
          exit 1
        }
        dz::plugin::enable "$@" || exit 1
        ;;
      disable)
        (( $# > 0 )) || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin disable <name> [name...]"
          exit 1
        }
        dz::plugin::disable "$@" || exit 1
        ;;
      info)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing plugin name." "Usage: dreamzsh plugin info <name>"
          exit 1
        }
        dz::plugin::info "$@" || exit 1
        ;;
      *)
        dz::unknown_command "$subcommand" "${plugin_subcommands[@]}"
        dz::help::plugin
        exit 1
        ;;
    esac
    ;;
  theme)
    subcommand="${1:-help}"
    shift || true

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command theme "$subcommand" || exit 1
      exit 0
    fi

    case "$subcommand" in
      help|-h|--help)
        dz::help::theme
        ;;
      list)
        dz::theme::list
        ;;
      create)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing theme name." "Usage: dreamzsh theme create <name>"
          exit 1
        }
        dz::theme::create "$1" || exit 1
        ;;
      set)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing theme name." "Usage: dreamzsh theme set <name>"
          exit 1
        }
        dz::theme::set "$1" || exit 1
        ;;
      preview)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing theme name." "Usage: dreamzsh theme preview <name>"
          exit 1
        }
        dz::theme::preview "$1" || exit 1
        ;;
      current)
        dz::theme::current
        ;;
      *)
        dz::unknown_command "$subcommand" "${theme_subcommands[@]}"
        dz::help::theme
        exit 1
        ;;
    esac
    ;;
  profile)
    subcommand="${1:-help}"
    shift || true

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command profile "$subcommand" || exit 1
      exit 0
    fi

    case "$subcommand" in
      help|-h|--help)
        dz::help::profile
        ;;
      list)
        dz::profile::list
        ;;
      info)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing profile name." "Usage: dreamzsh profile info <name>"
          exit 1
        }
        dz::profile::info "$1" || exit 1
        ;;
      apply)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing profile name." "Usage: dreamzsh profile apply <name>"
          exit 1
        }
        dz::profile::apply "$1" || exit 1
        ;;
      current)
        dz::profile::current
        ;;
      export)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing export profile name." "Usage: dreamzsh profile export <new-name> [options]"
          exit 1
        }
        dz::profile::export "$@" || exit 1
        ;;
      import)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing archive path." "Usage: dreamzsh profile import <archive.tar.gz> [--apply]"
          exit 1
        }
        dz::profile::import "$@" || exit 1
        ;;
      *)
        dz::unknown_command "$subcommand" "${profile_subcommands[@]}"
        dz::help::profile
        exit 1
        ;;
    esac
    ;;
  backup)
    subcommand="${1:-help}"
    shift || true

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      dz::help::command backup "$subcommand" || exit 1
      exit 0
    fi

    case "$subcommand" in
      help|-h|--help)
        dz::help::backup
        ;;
      create)
        dz::backup::create "$@" || exit 1
        ;;
      list)
        dz::backup::list
        ;;
      restore)
        [[ -n "${1:-}" ]] || {
          dz::usage_error "Missing backup archive name." "Usage: dreamzsh backup restore <archive>"
          exit 1
        }
        dz::backup::restore "$1" || exit 1
        ;;
      clean)
        dz::backup::clean "${1:-}" || exit 1
        ;;
      *)
        dz::unknown_command "$subcommand" "${backup_subcommands[@]}"
        dz::help::backup
        exit 1
        ;;
    esac
    ;;
  *)
    dz::unknown_command "$command_name" "${main_commands[@]}"
    dz::help::main
    exit 1
    ;;
esac
